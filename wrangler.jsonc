{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "balajitechlabs-com",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "out"
  },
  "routes": [
    {
      "pattern": "balajitechlabs.com",
      "custom_domain": true
    },
    {
      "pattern": "www.balajitechlabs.com",
      "custom_domain": true
    }
  ]
}
