# ========================================================
# balajitechlabs.com - Environment Variables Example
# Copy this file to .env or mount via 1Password Environments
# ========================================================

# The public URL of the website
NEXT_PUBLIC_SITE_URL=https://balajitechlabs.com

# Cloudflare Account ID (Optional: only needed for local CLI commands)
# Find this in your Cloudflare Dashboard under Workers & Pages, or run: bun x wrangler whoami
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
